# Config for scripts/start-cloud-services.sh: the app built and run locally
# (Docker, on your machine) but pointed at real managed services on IBM
# Cloud — Db2 on Cloud for the database, App ID for identity — instead of
# the local Postgres/Keycloak containers docker-compose.yml starts.
#
# This is NOT the full cloud deployment (that's deploy/deploy-to-vm.sh +
# deploy/vm-setup.sh, which also puts the app itself on a VM behind
# Cloudflare). This is for developing/testing against the real IBM Cloud
# services from your own machine.
#
# Copy this file to .env.cloud-services and fill in the values below from
# the IBM Cloud console, then run scripts/start-cloud-services.sh.
#
# Values are CHANGEME_* placeholders, not angle-bracket <...> ones: this
# file gets sourced directly by the start script, and "<" is a shell
# redirection operator — an unfilled <hostname>-style placeholder would
# fail with a syntax error instead of the intended "please fill this in"
# message.

# --- Db2 on Cloud ---
# From the Db2 service's "Service credentials" in the IBM Cloud console.
# Trimmed to host/port/database only — do NOT append the
# :sslConnection=true;... suffix here; server.xml already sets those as
# discrete properties (the Db2 JDBC driver rejects them embedded in the URL
# via Liberty's generic java.sql.Driver mechanism — see server.xml's
# comment). Composed from the credentials' "hostname", "port", and "db"
# fields:
#   DB_JDBC_URL=jdbc:db2://<hostname>:<port>/<db>
DB_JDBC_URL=jdbc:db2://CHANGEME_hostname:CHANGEME_port/CHANGEME_db
DB_DRIVER_CLASS=com.ibm.db2.jcc.DB2Driver
DB_USER=CHANGEME_the_credentials_username
DB_PASSWORD=CHANGEME_the_credentials_password
# The credentials' "certificate_base64" field, base64-decoded, saved as
# backend/certs/ibm-db2-ca.pem (already present in this repo — only replace
# it if your instance issues a different CA). The Docker build bundles
# whatever's in backend/certs/ into the backend image's truststore
# automatically; nothing else to configure here.

# --- IBM Cloud App ID ---
# From the App ID instance's "Service credentials" and its application
# registration (Applications tab — register a "Single Page Application").
# <region> and <tenantID> below come from the same credentials.
OIDC_ISSUER=https://CHANGEME_region.appid.cloud.ibm.com/oauth/v4/CHANGEME_tenantID
OIDC_JWKS_URI=https://CHANGEME_region.appid.cloud.ibm.com/oauth/v4/CHANGEME_tenantID/publickeys
OIDC_AUDIENCE=CHANGEME_the_applications_clientId
OIDC_TOKEN_ENDPOINT=https://CHANGEME_region.appid.cloud.ibm.com/oauth/v4/CHANGEME_tenantID/token
OIDC_USERINFO_ENDPOINT=https://CHANGEME_region.appid.cloud.ibm.com/oauth/v4/CHANGEME_tenantID/userinfo
OIDC_CLIENT_ID=CHANGEME_the_applications_clientId
REACT_APP_CLIENT_ID=CHANGEME_the_applications_clientId
REACT_APP_OIDC_AUTHORIZATION_ENDPOINT=https://CHANGEME_region.appid.cloud.ibm.com/oauth/v4/CHANGEME_tenantID/authorization
# In the App ID application's config, add this exact redirect URI to its
# allow-list (see AuthContext.js's pkceRedirectUri) — App ID rejects the
# callback otherwise:
#   http://localhost:3000/auth/callback

# --- App-level config (SPEC.md §6.2/§6.4/§10.6) ---
# Generate a real value: openssl rand -base64 32
EMAIL_CONFIG_ENCRYPTION_KEY=CHANGEME_generate_a_real_random_secret
BORROW_LOAN_DAYS=14
RESERVATION_EXPIRY_DAYS=7
