<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
  <persistence-unit name="default" transaction-type="JTA">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <jta-data-source>jdbc/PostgresDS</jta-data-source>

    <!-- Explicitly list cross-module entities -->
    <class>com.shelfinity.user.entity.User</class>
    <class>com.shelfinity.user.entity.UserRegistrationRequest</class>
    <class>com.shelfinity.book.entity.Book</class>
    <class>com.shelfinity.reservation.entity.Reservation</class>
    <class>com.shelfinity.queue.entity.QueueItem</class>

    <!-- Then optionally control class scanning -->
    <exclude-unlisted-classes>false</exclude-unlisted-classes>

    <properties>
      <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
      <property name="eclipselink.target-database" value="PostgreSQL"/>
      <property name="eclipselink.logging.parameters" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
