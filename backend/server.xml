<?xml version="1.0" encoding="UTF-8"?>
<server description="Shelfinity Backend Server">

    <!-- Enable HTTP/2 endpoint -->
    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9080"
                  httpsPort="9443" />

    <!-- Database configuration -->
    <dataSource id="shelfinityDS" jndiName="jdbc/shelfinityDS">
        <jdbcDriver libraryRef="PostgreSQLLib" />
        <properties.postgresql serverName="${env.DB_HOST}"
                              portNumber="${env.DB_PORT}"
                              databaseName="${env.DB_NAME}"
                              user="${env.DB_USER}"
                              password="${env.DB_PASSWORD}" />
    </dataSource>

    <!-- PostgreSQL JDBC driver library -->
    <library id="PostgreSQLLib">
        <fileset dir="${shared.resource.dir}/lib" includes="postgresql-*.jar" />
    </library>

    <!-- Feature manager - using Jakarta EE 10 Web Profile with MicroProfile -->
    <featureManager>
        <feature>webProfile-10.0</feature>
        <feature>jdbc-4.3</feature>
        <feature>mpJwt-2.1</feature>
        <feature>mpOpenAPI-3.1</feature>
        <feature>mpHealth-4.0</feature>
    </featureManager>

    <!-- MicroProfile JWT Configuration -->
    <mpJwt id="jwt"
            issuer="${env.OIDC_ISSUER}"
            jwksUri="${env.OIDC_ISSUER}/protocol/openid-connect/certs" />

    <!-- OpenAPI Configuration -->
    <mpOpenAPI />

    <!-- Application deployment -->
    <application id="shelfinity-backend" name="shelfinity-backend" location="shelfinity-backend.war" />

</server>