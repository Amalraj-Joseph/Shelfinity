<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="shelfinityPU" transaction-type="JTA">
        <jta-data-source>jdbc/shelfinityDS</jta-data-source>
        
        <!-- Entity classes -->
        <class>com.shelfinity.users.User</class>
        <class>com.shelfinity.books.Book</class>
        <class>com.shelfinity.queues.QueueItem</class>
        <class>com.shelfinity.email.EmailConfig</class>
        <class>com.shelfinity.email.EncryptedStringConverter</class>
        <class>com.shelfinity.persistence.UuidStringConverter</class>
        <class>com.shelfinity.reservations.Reservation</class>
        
        <!-- Properties -->
        <properties>
            <!-- Jakarta EE 10 JPA properties -->
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
            <property name="jakarta.persistence.schema-generation.create-source" value="metadata"/>
            <property name="jakarta.persistence.schema-generation.drop-source" value="metadata"/>
        </properties>
    </persistence-unit>

</persistence>
