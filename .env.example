# Shelfinity Environment Configuration
# Copy this file to .env and update values for your deployment

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Backend Configuration
BACKEND_URL=http://localhost:9080
OPENAPI_SERVER_URL=http://localhost:9080

# Database Configuration — vendor-neutral (SPEC.md-style rationale: see
# backend/server.xml). Both DB_JDBC_URL and DB_DRIVER_CLASS must match the
# same vendor; the matching driver jar just needs to be present in the
# backend image (Postgres and Db2 both ship by default — see Dockerfile).
#   Postgres (this docker-compose stack):
#     DB_JDBC_URL=jdbc:postgresql://postgres:5432/shelfinity
#     DB_DRIVER_CLASS=org.postgresql.Driver
#   IBM Db2 (cloud): host/port/database name come from the service
#   credentials in the IBM Cloud console. Db2 on Cloud requires SSL, and its
#   certificate is typically issued by a private CA (not one already in the
#   JDK's default trust store) — drop the CA cert (the "certificate_base64"
#   field in the service credentials, base64-decoded) into backend/certs/ and
#   the Docker build bundles it into a truststore automatically (see
#   backend/Dockerfile); point sslTrustStoreLocation at that file:
#     DB_JDBC_URL=jdbc:db2://<host>:<port>/<database>:sslConnection=true;sslTrustStoreLocation=/opt/ol/wlp/usr/shared/resources/lib/app-truststore.jks;sslTrustStorePassword=changeit;
#     DB_DRIVER_CLASS=com.ibm.db2.jcc.DB2Driver
DB_JDBC_URL=jdbc:postgresql://postgres:5432/shelfinity
DB_DRIVER_CLASS=org.postgresql.Driver
DB_USER=shelfinity
DB_PASSWORD=changeme_in_production

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
# Must equal the "iss" claim Keycloak actually puts in tokens — that's
# whatever hostname the browser used to reach it (localhost:8080 in this
# docker-compose setup), NOT the internal Docker network hostname.
OIDC_ISSUER=http://localhost:8080/realms/shelfinity
# Separate from OIDC_ISSUER: where the *backend container* fetches the JWKS
# from, which must be reachable from inside the Docker network.
OIDC_JWKS_URI=http://keycloak:8080/realms/shelfinity/protocol/openid-connect/certs
OIDC_AUDIENCE=shelfinity-backend

# pkce mode only (see REACT_APP_AUTH_FLOW below) — used by the backend's
# POST /auth/oidc-exchange, which does the PKCE code-for-token exchange and
# UserInfo lookup server-side rather than the browser calling App ID
# directly. Confirmed by hand against a real App ID tenant: its token
# endpoint sends no CORS headers at all, so the browser can't call it
# directly regardless. No client secret needed — App ID has a non-standard
# convention (see AuthResource.java's oidc-exchange method) where the PKCE
# code_verifier itself fills the Basic-Auth slot a real secret would
# normally go in. All unused/unset for local Keycloak.
#   OIDC_TOKEN_ENDPOINT=https://<region>.appid.cloud.ibm.com/oauth/v4/<tenantID>/token
#   OIDC_USERINFO_ENDPOINT=https://<region>.appid.cloud.ibm.com/oauth/v4/<tenantID>/userinfo
#   OIDC_CLIENT_ID=<the App ID application's client ID>
# OIDC_TOKEN_ENDPOINT=
# OIDC_USERINFO_ENDPOINT=
# OIDC_CLIENT_ID=

# Business rule configuration (SPEC.md §6.2/§6.4, §10.5) — both optional, shown
# with their defaults.
BORROW_LOAN_DAYS=14
RESERVATION_EXPIRY_DAYS=7

# SMTP credential encryption key (SPEC.md §10.6) — REQUIRED in any real
# deployment. The backend ships an insecure dev-only default if this is unset;
# generate a long random value for anything beyond local development, e.g.:
#   openssl rand -base64 32
EMAIL_CONFIG_ENCRYPTION_KEY=changeme_generate_a_real_random_secret

# React App Configuration (for frontend)
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_REALM=shelfinity
REACT_APP_CLIENT_ID=shelfinity-frontend
# Optional — defaults to same-origin "/api" (works with the CRA dev proxy and
# the production nginx config as-is). Only set this if the frontend needs to
# talk to a backend on a different origin.
# REACT_APP_API_BASE_URL=/api

# Login flow — vendor-neutral (see AuthContext.js's AUTH_FLOW comment).
# Leave unset/'ropc' for Keycloak (this docker-compose stack): the in-page
# form POSTs credentials straight to the token endpoint. IBM Cloud App ID
# (cloud) requires 'pkce' instead — App ID's password-grant flow needs a
# client secret, which a static SPA has nowhere safe to keep, so cloud
# deployment uses a redirect-based Authorization Code + PKCE flow against
# App ID's hosted login page instead. Only the authorization endpoint is
# needed here — that's a page redirect, not a fetch. The token exchange
# itself happens backend-side; see OIDC_TOKEN_ENDPOINT etc. above.
#   REACT_APP_AUTH_FLOW=pkce
#   REACT_APP_OIDC_AUTHORIZATION_ENDPOINT=https://<region>.appid.cloud.ibm.com/oauth/v4/<tenantID>/authorization
# REACT_APP_AUTH_FLOW=ropc
# REACT_APP_OIDC_AUTHORIZATION_ENDPOINT=

# PostgreSQL Admin (for initial setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=postgres

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_in_production