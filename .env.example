# Shelfinity Environment Configuration
# Copy this file to .env and update values for your deployment

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Backend Configuration
BACKEND_URL=http://localhost:9080
OPENAPI_SERVER_URL=http://localhost:9080

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shelfinity
DB_USER=shelfinity
DB_PASSWORD=changeme_in_production

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
# Must equal the "iss" claim Keycloak actually puts in tokens — that's
# whatever hostname the browser used to reach it (localhost:8080 in this
# docker-compose setup), NOT the internal Docker network hostname.
OIDC_ISSUER=http://localhost:8080/realms/shelfinity
# Separate from OIDC_ISSUER: where the *backend container* fetches the JWKS
# from, which must be reachable from inside the Docker network.
OIDC_JWKS_URI=http://keycloak:8080/realms/shelfinity/protocol/openid-connect/certs
OIDC_AUDIENCE=shelfinity-backend

# Business rule configuration (SPEC.md §6.2/§6.4, §10.5) — both optional, shown
# with their defaults.
BORROW_LOAN_DAYS=14
RESERVATION_EXPIRY_DAYS=7

# SMTP credential encryption key (SPEC.md §10.6) — REQUIRED in any real
# deployment. The backend ships an insecure dev-only default if this is unset;
# generate a long random value for anything beyond local development, e.g.:
#   openssl rand -base64 32
EMAIL_CONFIG_ENCRYPTION_KEY=changeme_generate_a_real_random_secret

# React App Configuration (for frontend)
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_REALM=shelfinity
REACT_APP_CLIENT_ID=shelfinity-frontend
# Optional — defaults to same-origin "/api" (works with the CRA dev proxy and
# the production nginx config as-is). Only set this if the frontend needs to
# talk to a backend on a different origin.
# REACT_APP_API_BASE_URL=/api

# PostgreSQL Admin (for initial setup)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=postgres

# Keycloak Admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_in_production